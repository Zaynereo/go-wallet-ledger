# Local development placeholders only. Do not put real secrets here.
# The process does not load this file automatically; export the variables
# yourself or set them in Compose.

HTTP_ADDR=:8080
MYSQL_DSN=user:password@tcp(127.0.0.1:3306)/ledger?parseTime=true&charset=utf8mb4&loc=UTC
PUBLISHER=log
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=ledger.events
LOG_LEVEL=info
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s
SHUTDOWN_TIMEOUT=15s
LOCK_WAIT_TIMEOUT=10s
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
